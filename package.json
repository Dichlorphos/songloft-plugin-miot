{
  "name": "miot",
  "version": "2026.9.21",
  "description": "通过 MIoT 协议把歌曲投放到智能音箱设备",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/fetch-holidays.mjs && node scripts/build-pinyin-data.mjs",
    "build": "node scripts/songloft-plugin.cjs build",
    "predev": "node scripts/fetch-holidays.mjs && node scripts/build-pinyin-data.mjs",
    "dev": "node scripts/songloft-plugin.cjs dev",
    "validate": "node scripts/songloft-plugin.cjs validate",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --import ./scripts/register-ts-hooks.mjs --test \"src/**/*.test.ts\" \"tests/**/*.test.mjs\"",
    "publish:release": "node scripts/songloft-plugin.cjs publish",
    "fetch:holidays": "node scripts/fetch-holidays.mjs",
    "build:pinyin": "node scripts/build-pinyin-data.mjs",
    "sync:tts": "node scripts/sync-tts-commands.mjs"
  },
  "devDependencies": {
    "@songloft/plugin-builder": "^2.13.7",
    "@songloft/plugin-sdk": "^2.13.8",
    "@types/node": "^24.13.5",
    "pinyin-pro": "^3.28.1",
    "segmentit": "^2.0.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "pako": "^1.0.11"
  }
}
