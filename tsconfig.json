{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["@songloft/plugin-sdk"],
    "noEmit": true,
    // 纯逻辑测试用 node:test 直接跑 .ts（Node 24 原生剥离类型），
    // 因此测试里的相对导入必须带 .ts 扩展名，tsc 需要显式放行。
    "allowImportingTsExtensions": true
  },
  // 主检查只覆盖插件源码：Node 类型不参与，误用 node:* 内置模块会在此报错
  // （QuickJS 运行时没有这些模块）。
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
